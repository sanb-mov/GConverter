# Normalise line endings so the repository stays identical across
# Windows, Linux and macOS checkouts.
* text=auto eol=lf

# Shell scripts must keep LF or they break on Unix.
*.sh text eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets: never touch these.
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.gif binary
*.mp4 binary
*.mkv binary
*.mov binary
*.avi binary
*.webm binary
*.mp3 binary
*.wav binary
*.flac binary
*.exe binary
*.dll binary
*.7z binary
*.zip binary
