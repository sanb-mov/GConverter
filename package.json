{
  "name": "gconverter",
  "version": "1.1.0",
  "description": "GConverter — Convert anything. Keep everything.",
  "main": "./out/main/index.js",
  "author": "sanb-mov",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node tests/fixtures/generate.mjs",
    "icons": "electron build/make-icons.cjs",
    "ytdlp": "node build/fetch-ytdlp.cjs",
    "dist": "node build/fetch-ytdlp.cjs && electron-vite build && electron-builder",
    "dist:win": "node build/fetch-ytdlp.cjs --platform=win32 && electron-vite build && electron-builder --win",
    "dist:linux": "node build/fetch-ytdlp.cjs --platform=linux && electron-vite build && electron-builder --linux",
    "dist:mac": "node build/fetch-ytdlp.cjs --platform=darwin && electron-vite build && electron-builder --mac"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  }
}
